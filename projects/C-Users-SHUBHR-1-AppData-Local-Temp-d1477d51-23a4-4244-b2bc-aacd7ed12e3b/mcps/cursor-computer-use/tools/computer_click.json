{
  "name": "computer_click",
  "description": "Click at a screen coordinate.",
  "arguments": {
    "type": "object",
    "properties": {
      "x": {
        "type": "integer"
      },
      "y": {
        "type": "integer"
      },
      "button": {
        "type": "string",
        "enum": [
          "left",
          "right",
          "middle"
        ],
        "description": "Mouse button. Defaults to left."
      },
      "count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3,
        "description": "Click count; 2 double-clicks. Defaults to 1."
      },
      "zoom_id": {
        "type": "string",
        "description": "Id from a computer_zoom result: x and y are then pixels of that zoom image."
      }
    },
    "required": [
      "x",
      "y"
    ]
  }
}